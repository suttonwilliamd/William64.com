---
import Layout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects } from "../data/projects";
---

<Layout
  title="William Sutton — Projects, notes & curious experiments"
  description="William Sutton’s personal notebook: software projects, creative tools, writing, and experiments with AI."
>
  <PageHeader
    title="A little curiosity. A lot of rabbit holes."
    eyebrow="William Sutton / Builder & curious human"
    description="I build software, collect interesting ideas, and follow the threads between them. This is my notebook for useful tools, creative experiments, and what I learn along the way."
    hero
  >
    <div class="actions">
      <a class="btn btn-primary" href="/projects/"
        >Explore the projects <span aria-hidden="true">→</span></a
      ><a class="btn" href="/about/">A bit about me</a>
    </div>
  </PageHeader>
  <section aria-labelledby="featured-heading">
    <div class="section-heading">
      <h2 id="featured-heading">From the workshop</h2><a
        class="text-link"
        href="/projects/">All projects →</a>
    </div>
    <div class="project-list">
      {
        projects
          .slice(0, 2)
          .map((project, index) => (
            <ProjectCard project={project} index={index} compact />
          ))
      }
    </div>
  </section>
  <section class="section" aria-labelledby="explore-heading">
    <div class="section-heading">
      <h2 id="explore-heading">Follow a different thread</h2><p>
        Ideas, tools, and a second perspective.
      </p>
    </div>
    <div class="grid grid-three">
      <a class="card link-card" href="/sirq/"
        ><span class="eyebrow">Project notebook</span><h3>
          Fewer alerts. More signal.
        </h3><p>
          SIRQ explores which alerts are worth an interruption, with
          deterministic policy keeping authority.
        </p><span class="text-link">Explore the SIRQ demo →</span></a
      >
      <a class="card link-card" href="/blog/"
        ><span class="eyebrow">Writing</span><h3>
          Notes from the rabbit hole.
        </h3><p>
          Software, systems thinking, and retro tech. A space for ideas that
          need more than a README.
        </p><span class="text-link">Visit the notebook →</span></a
      >
      <a class="card link-card" href="/aaron/"
        ><span class="eyebrow">AI-authored</span><h3>
          Aaron has a notebook, too.
        </h3><p>
          My AI assistant’s process logs and reflections. A different voice,
          clearly marked as AI-written.
        </p><span class="text-link">Meet Aaron →</span></a
      >
    </div>
  </section>
  <aside class="outro">
    <div>
      <p class="eyebrow">Always learning</p><h2>
        Something worth exploring?
      </h2><p>
        I’m happy to talk projects, compare notes, or follow a promising
        recommendation.
      </p>
    </div><a class="btn" href="mailto:suttonwilliamd@gmail.com">Say hello ↗</a>
  </aside>
</Layout>
