---
import TerminalHero from "../components/TerminalHero.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import ConversionTracking from "../components/ConversionTracking.astro";

const pageTitle = "William Sutton - Builder, Systems Thinker, and Maker";
const pageDescription = "I build practical software systems, experiments, and production-ready tools across AI, automation, and web platforms.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css?v=slate2" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="header">
      <div class="header-inner">
        <Navigation />
      </div>
    </header>

    <main id="main-content">
      <!-- Hero Section -->
      <section class="hero">
        <div class="container">
          <h1 class="hero-title">
            <span class="text-gradient">William Sutton</span>
          </h1>
          <p class="hero-subtitle">
            I build practical software systems, experiments, and production-ready tools across AI, automation, and web platforms.
          </p>
          <p class="site-spine">
            This site is my workbench: shipped projects, technical notes, and ongoing experiments. If you need implementation help, see the dedicated services page.
          </p>
          <div class="hero-actions">
            <a href="/projects" class="btn btn-primary">See Shipped Results</a>
            <a href="/services" class="btn btn-secondary" data-conversion-event="services_cta_click" data-conversion-label="home_hero_services_engagement">Services & Engagement</a>
          </div>

          <div class="metrics">
            <div class="metric">
              <div class="metric-value">10+</div>
              <div class="metric-label">Years Learning</div>
            </div>
            <div class="metric">
              <div class="metric-value" id="github-stars">---</div>
              <div class="metric-label">GitHub Stars</div>
            </div>
            <div class="metric">
              <div class="metric-value" id="total-stars">---</div>
              <div class="metric-label">Total Stars</div>
            </div>
            <div class="metric">
              <div class="metric-value" id="total-repos">---</div>
              <div class="metric-label">Repositories</div>
            </div>
          </div>

          <TerminalHero />
        </div>
      </section>

      <!-- Workbench Callout -->
      <section class="section" aria-labelledby="workbench-callout-title" style="padding-top: var(--space-8); padding-bottom: var(--space-8); background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
        <div class="container" style="display: flex; flex-direction: column; gap: var(--space-4); align-items: center; text-align: center;">
          <h2 class="section-title" id="workbench-callout-title" style="margin-bottom: 0;">What you'll find here</h2>
          <p class="section-subtitle" style="max-width: 760px;">
            Build notes, production fixes, and project writeups. If you came here specifically for consulting or contract work, use the separate services page.
          </p>
          <div class="hero-actions" style="margin-top: 0;">
            <a href="/projects" class="btn btn-primary">Browse Projects</a>
            <a href="/services" class="btn btn-secondary" data-conversion-event="services_cta_click" data-conversion-label="home_workbench_callout_services_link">Go to Services Page</a>
          </div>
        </div>
      </section>

      <!-- Fast Proof Snippets -->
      <section class="section" aria-labelledby="proof-snippets-title">
        <div class="container">
          <div class="section-header" style="margin-bottom: var(--space-8);">
            <h2 class="section-title" id="proof-snippets-title">Recent Shipped Fixes</h2>
            <a href="/projects" class="btn btn-ghost">View Full Project Log →</a>
          </div>

          <div class="grid grid-3" style="gap: var(--space-5);">
            <article class="project-card">
              <div class="project-body">
                <h3 class="card-title">TPC Server Hardening</h3>
                <p class="card-description">Shipped strict MCP input validation plus clear error paths to reduce bad automation runs.</p>
                <p class="card-description" style="margin-top: var(--space-2); color: var(--color-text-secondary);">
                  <strong style="color: var(--color-text);">Outcome:</strong> Fewer broken runs during agent orchestration and faster issue triage from actionable errors.
                </p>
                <div class="project-tags">
                  <span class="tag">Reliability</span>
                  <span class="tag">API Safety</span>
                </div>
              </div>
              <div class="project-footer">
                <a href="/projects" class="btn btn-secondary">See Similar Delivery</a>
              </div>
            </article>

            <article class="project-card">
              <div class="project-body">
                <h3 class="card-title">CortexPool Regression Coverage</h3>
                <p class="card-description">Added regression tests and fallback handling for TPC fetch paths to prevent repeat outages.</p>
                <p class="card-description" style="margin-top: var(--space-2); color: var(--color-text-secondary);">
                  <strong style="color: var(--color-text);">Outcome:</strong> Reduced repeat failures by catching regressions before deploy and preserving degraded-mode reliability.
                </p>
                <div class="project-tags">
                  <span class="tag">Test Coverage</span>
                  <span class="tag">Failure Recovery</span>
                </div>
              </div>
              <div class="project-footer">
                <a href="/projects" class="btn btn-secondary">See More Reliability Work</a>
              </div>
            </article>

            <article class="project-card">
              <div class="project-body">
                <h3 class="card-title">Production Portability Patch</h3>
                <p class="card-description">Moved default service port with PORT override support so deployments work cleanly across hosts.</p>
                <p class="card-description" style="margin-top: var(--space-2); color: var(--color-text-secondary);">
                  <strong style="color: var(--color-text);">Outcome:</strong> Faster environment handoffs and fewer deployment blockers across staging and production hosts.
                </p>
                <div class="project-tags">
                  <span class="tag">Deployability</span>
                  <span class="tag">Ops Ready</span>
                </div>
              </div>
              <div class="project-footer">
                <a href="/projects" class="btn btn-secondary">See Deployment Fixes</a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- Featured Projects from GitHub -->
      <section class="section" style="background: var(--color-surface);">
        <div class="container">
          <div class="section-header">
            <h2 class="section-title">Featured Projects</h2>
            <a href="https://github.com/suttonwilliamd?tab=repositories" class="btn btn-ghost" target="_blank" rel="noopener">View All →</a>
          </div>

          <div class="grid grid-2" id="featured-projects">
            <div class="loading-placeholder">Loading projects from GitHub...</div>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <ConversionTracking />

    <script>
      const GITHUB_USERNAME = 'suttonwilliamd';

      async function fetchGitHubStats() {
        try {
          const reposRes = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=100`);
          const repos = await reposRes.json();

          if (Array.isArray(repos)) {
            const totalStars = repos.reduce((acc, repo) => acc + (repo.stargazers_count || 0), 0);
            const topRepos = repos.sort((a, b) => b.stargazers_count - a.stargazers_count).slice(0, 4);

            document.getElementById('total-stars').textContent = totalStars.toLocaleString();
            document.getElementById('total-repos').textContent = repos.length;

            const maxStars = Math.max(...topRepos.map(r => r.stargazers_count), 1);
            document.getElementById('github-stars').textContent = topRepos[0]?.stargazers_count.toLocaleString() || '0';

            const projectsContainer = document.getElementById('featured-projects');
            if (projectsContainer && topRepos.length > 0) {
              projectsContainer.innerHTML = topRepos.map(repo => `
                <article class="project-card">
                  <div class="project-header">
                    <div style="display: flex; gap: var(--space-2);">
                      <div class="terminal-dot red"></div>
                      <div class="terminal-dot yellow"></div>
                      <div class="terminal-dot green"></div>
                    </div>
                    <span class="project-title">${repo.name}</span>
                  </div>
                  <div class="project-body">
                    <h3 class="card-title">${repo.description || 'No description available'}</h3>
                    <div class="project-tags">
                      ${repo.language ? `<span class="tag">${repo.language}</span>` : ''}
                      <span class="tag">⭐ ${repo.stargazers_count}</span>
                      <span class="tag">🍴 ${repo.forks_count}</span>
                    </div>
                  </div>
                  <div class="project-footer">
                    <a href="${repo.html_url}" class="btn btn-primary" target="_blank" rel="noopener">View Project</a>
                    ${repo.homepage ? `<a href="${repo.homepage}" class="btn btn-secondary" target="_blank" rel="noopener">Live Demo</a>` : ''}
                  </div>
                </article>
              `).join('');
            }
          }
        } catch (error) {
          console.error('Error fetching GitHub stats:', error);
          document.getElementById('github-stars').textContent = 'N/A';
          document.getElementById('total-stars').textContent = 'N/A';
          document.getElementById('total-repos').textContent = 'N/A';
        }
      }

      fetchGitHubStats();
    </script>
  </body>
</html>
