---
import TerminalHero from "../components/TerminalHero.astro";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

const pageTitle = "William Sutton - AI Automation & Full-Stack Delivery";
const pageDescription = "I help teams ship AI automation, developer tooling, and production-ready web experiences in short, practical sprints.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="header">
      <div class="header-inner">
        <Navigation />
      </div>
    </header>

    <main id="main-content">
      <!-- Hero Section -->
      <section class="hero">
        <div class="container">
          <h1 class="hero-title">
            <span class="text-gradient">William Sutton</span>
          </h1>
          <p class="hero-subtitle">
            AI automation + full-stack delivery for teams that need momentum this week.
          </p>
          <p class="site-spine">
            I build practical systems: agentic workflows, internal tools, and polished web apps.
          </p>
          <div class="hero-actions">
            <a href="mailto:suttonwilliamd@gmail.com?subject=AI%20Automation%20Sprint" class="btn btn-primary">Book an AI Sprint</a>
            <a href="/projects" class="btn btn-secondary">View Proof of Work</a>
          </div>

          <div class="service-snippets" style="margin-top: var(--space-6); display: flex; gap: var(--space-2); flex-wrap: wrap; justify-content: center;">
            <span class="tag">⚡ 48-hour automation prototypes</span>
            <span class="tag">🧠 AI agent workflow integration</span>
            <span class="tag">🛠️ Legacy bugfix + shipping support</span>
          </div>

          <div class="metrics">
            <div class="metric">
              <div class="metric-value">10+</div>
              <div class="metric-label">Years Learning</div>
            </div>
            <div class="metric">
              <div class="metric-value" id="github-stars">---</div>
              <div class="metric-label">GitHub Stars</div>
            </div>
            <div class="metric">
              <div class="metric-value" id="total-stars">---</div>
              <div class="metric-label">Total Stars</div>
            </div>
            <div class="metric">
              <div class="metric-value" id="total-repos">---</div>
              <div class="metric-label">Repositories</div>
            </div>
          </div>

          <TerminalHero />
        </div>
      </section>

      <!-- Revenue-Oriented Offer Stack -->
      <section class="section" aria-labelledby="offer-stack-title">
        <div class="container">
          <div class="section-header" style="margin-bottom: var(--space-8);">
            <h2 class="section-title" id="offer-stack-title">Launch-Week AI Delivery Offers</h2>
            <a href="mailto:suttonwilliamd@gmail.com?subject=Scope%20a%20paid%20sprint" class="btn btn-ghost">Get scoped in 24h →</a>
          </div>

          <div class="grid grid-3" style="gap: var(--space-5);">
            <article class="project-card">
              <div class="project-body">
                <h3 class="card-title">48-Hour Automation Prototype</h3>
                <p class="card-description">Best for teams stuck in "idea mode". I deliver one working flow tied to your real tools and data.</p>
                <div class="project-tags">
                  <span class="tag">Fast validation</span>
                  <span class="tag">Production-minded</span>
                </div>
              </div>
              <div class="project-footer">
                <a href="mailto:suttonwilliamd@gmail.com?subject=48-hour%20automation%20prototype&body=Team%3A%0AGoal%3A%0ASystems%20to%20connect%3A" class="btn btn-primary">Start This Sprint</a>
              </div>
            </article>

            <article class="project-card">
              <div class="project-body">
                <h3 class="card-title">Legacy Bugfix + Ship Support</h3>
                <p class="card-description">For critical blockers. I triage, patch, and hand off with clean notes so your team can keep velocity.</p>
                <div class="project-tags">
                  <span class="tag">Hands-on debugging</span>
                  <span class="tag">Clear handoff docs</span>
                </div>
              </div>
              <div class="project-footer">
                <a href="mailto:suttonwilliamd@gmail.com?subject=Critical%20bugfix%20support&body=Repo%3A%0ACurrent%20blocker%3A%0ADeadline%3A" class="btn btn-primary">Request Rescue</a>
              </div>
            </article>

            <article class="project-card">
              <div class="project-body">
                <h3 class="card-title">Agent Workflow Integration</h3>
                <p class="card-description">Turn repetitive team work into reliable agent runbooks with review gates and measurable outcomes.</p>
                <div class="project-tags">
                  <span class="tag">Process mapping</span>
                  <span class="tag">Execution playbooks</span>
                </div>
              </div>
              <div class="project-footer">
                <a href="mailto:suttonwilliamd@gmail.com?subject=Agent%20workflow%20integration&body=Team%20size%3A%0AWeekly%20repetitive%20tasks%3A%0ATarget%20outcome%3A" class="btn btn-primary">Plan Integration</a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- Featured Projects from GitHub -->
      <section class="section" style="background: var(--color-surface);">
        <div class="container">
          <div class="section-header">
            <h2 class="section-title">Featured Projects</h2>
            <a href="https://github.com/suttonwilliamd?tab=repositories" class="btn btn-ghost" target="_blank" rel="noopener">View All →</a>
          </div>

          <div class="grid grid-2" id="featured-projects">
            <div class="loading-placeholder">Loading projects from GitHub...</div>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const GITHUB_USERNAME = 'suttonwilliamd';

      async function fetchGitHubStats() {
        try {
          const reposRes = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=100`);
          const repos = await reposRes.json();

          if (Array.isArray(repos)) {
            const totalStars = repos.reduce((acc, repo) => acc + (repo.stargazers_count || 0), 0);
            const topRepos = repos.sort((a, b) => b.stargazers_count - a.stargazers_count).slice(0, 4);

            document.getElementById('total-stars').textContent = totalStars.toLocaleString();
            document.getElementById('total-repos').textContent = repos.length;

            const maxStars = Math.max(...topRepos.map(r => r.stargazers_count), 1);
            document.getElementById('github-stars').textContent = topRepos[0]?.stargazers_count.toLocaleString() || '0';

            const projectsContainer = document.getElementById('featured-projects');
            if (projectsContainer && topRepos.length > 0) {
              projectsContainer.innerHTML = topRepos.map(repo => `
                <article class="project-card">
                  <div class="project-header">
                    <div style="display: flex; gap: var(--space-2);">
                      <div class="terminal-dot red"></div>
                      <div class="terminal-dot yellow"></div>
                      <div class="terminal-dot green"></div>
                    </div>
                    <span class="project-title">${repo.name}</span>
                  </div>
                  <div class="project-body">
                    <h3 class="card-title">${repo.description || 'No description available'}</h3>
                    <div class="project-tags">
                      ${repo.language ? `<span class="tag">${repo.language}</span>` : ''}
                      <span class="tag">⭐ ${repo.stargazers_count}</span>
                      <span class="tag">🍴 ${repo.forks_count}</span>
                    </div>
                  </div>
                  <div class="project-footer">
                    <a href="${repo.html_url}" class="btn btn-primary" target="_blank" rel="noopener">View Project</a>
                    ${repo.homepage ? `<a href="${repo.homepage}" class="btn btn-secondary" target="_blank" rel="noopener">Live Demo</a>` : ''}
                  </div>
                </article>
              `).join('');
            }
          }
        } catch (error) {
          console.error('Error fetching GitHub stats:', error);
          document.getElementById('github-stars').textContent = 'N/A';
          document.getElementById('total-stars').textContent = 'N/A';
          document.getElementById('total-repos').textContent = 'N/A';
        }
      }

      fetchGitHubStats();
    </script>
  </body>
</html>
