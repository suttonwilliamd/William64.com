---
import Layout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import TokenViewer from "../components/TokenViewer.jsx";
---

<Layout
  title="Token explorer | William64.com"
  description="An interactive GPT-2 vocabulary explorer. Decode a token ID or see how text becomes a sequence of tokens."
>
  <PageHeader
    title="What does a token look like?"
    eyebrow="Small experiments / Token explorer"
    description="A little toy built out of curiosity. Explore the GPT-2 vocabulary one ID at a time, or turn a piece of text into tokens. This is not the tokenizer used by every modern AI model."
  />
  <noscript
    ><p class="note">
      This interactive tool needs JavaScript to encode and decode text. The rest
      of the site works without it.
    </p></noscript
  >
  <TokenViewer client:load />
</Layout>
