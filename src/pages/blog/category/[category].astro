---
import Layout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import PostList from "../../../components/PostList.astro";
import { getPosts, slugify } from "../../../lib/posts";
export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(posts.map((post) => post.data.category))].map(
    (category) => ({
      params: { category: slugify(category) },
      props: {
        category,
        posts: posts.filter((post) => post.data.category === category),
      },
    }),
  );
}
const { category, posts } = Astro.props;
---

<Layout
  title={`${category} | William64.com Writing`}
  description={`Notes and articles about ${category.toLowerCase()} by William Sutton.`}
>
  <PageHeader
    title={category}
    eyebrow="Writing / Category"
    description={`${posts.length} article${posts.length === 1 ? "" : "s"} in the notebook.`}
    ><div class="actions">
      <a class="text-link" href="/blog/">← All writing</a>
    </div></PageHeader
  >
  <PostList posts={posts} />
</Layout>
