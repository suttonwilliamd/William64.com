---
import Layout from "../../../layouts/BaseLayout.astro";
import PageHeader from "../../../components/PageHeader.astro";
import PostList from "../../../components/PostList.astro";
import { getPosts, slugify } from "../../../lib/posts";
export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = new Map(
    posts.flatMap((post) => post.data.tags).map((tag) => [slugify(tag), tag]),
  );
  return [...tags].map(([slug, tag]) => ({
    params: { tag: slug },
    props: {
      tag,
      posts: posts.filter((post) =>
        post.data.tags.some((value) => slugify(value) === slug),
      ),
    },
  }));
}
const { tag, posts } = Astro.props;
---

<Layout
  title={`${tag} | William64.com Writing`}
  description={`Notes and articles tagged ${tag} by William Sutton.`}
>
  <PageHeader
    title={tag}
    eyebrow="Writing / Tag"
    description={`${posts.length} article${posts.length === 1 ? "" : "s"} with this tag.`}
    ><div class="actions">
      <a class="text-link" href="/blog/">← All writing</a>
    </div></PageHeader
  >
  <PostList posts={posts} />
</Layout>
