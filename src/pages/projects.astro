---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "Projects & Sprint Offers | William Sutton";
const pageDescription = "Proof-of-work projects plus fixed-scope AI automation sprint offers you can book this week.";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="header">
      <div class="header-inner">
        <Navigation />
      </div>
    </header>

    <main id="main-content">
      <section class="section">
        <div class="container">
          <h1 class="hero-title">Projects + Bookable Sprint Offers</h1>

          <div class="terminal-block" style="background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: var(--space-4) var(--space-6); font-family: var(--font-family-mono); margin-bottom: var(--space-6); max-width: 760px;">
            <div style="color: var(--color-text-tertiary);">
              <span style="color: #00ff00;">william64@portfolio</span>:<span style="color: #3399ff;">~$</span> cat sprint-offers.txt
            </div>
            <p style="color: var(--color-text-secondary); margin: var(--space-2) 0 0 0;">
              Need shipping momentum now? Pick a fixed-scope sprint, get a working deliverable, and keep full repo access.
            </p>
          </div>

          <div class="grid grid-2" style="margin-bottom: var(--space-7);">
            <article class="project-card">
              <div class="project-body">
                <h2 class="card-title">⚡ 48-Hour Automation Prototype</h2>
                <p class="text-muted">I ship a usable AI workflow MVP against one painful manual process (intake, triage, reporting, or support routing).</p>
                <div class="project-tags">
                  <span class="tag">Fast validation</span>
                  <span class="tag">Source included</span>
                  <span class="tag">Loom handoff</span>
                </div>
              </div>
              <div class="project-footer">
                <a href="mailto:suttonwilliamd@gmail.com?subject=48-hour%20Automation%20Prototype" class="btn btn-primary">Book this sprint</a>
              </div>
            </article>
            <article class="project-card">
              <div class="project-body">
                <h2 class="card-title">🛠️ Legacy Bugfix + Release Rescue</h2>
                <p class="text-muted">I stabilize a blocked release: diagnose, patch, verify, and hand back a clear change log you can ship same week.</p>
                <div class="project-tags">
                  <span class="tag">Production triage</span>
                  <span class="tag">Scoped fixes</span>
                  <span class="tag">Verification notes</span>
                </div>
              </div>
              <div class="project-footer">
                <a href="mailto:suttonwilliamd@gmail.com?subject=Legacy%20Bugfix%20Sprint" class="btn btn-primary">Request rescue sprint</a>
              </div>
            </article>
          </div>

          <div style="margin-bottom: var(--space-8);">
            <h2 class="section-title" style="font-size: 1.4rem;">Recent sprint-style outcomes</h2>
            <ul class="text-muted" style="line-height: 1.8; margin-top: var(--space-3);">
              <li><strong>TPC server workflow hardening:</strong> improved execution reliability and reduced manual retries via tighter orchestration logic.</li>
              <li><strong>Cortex/tooling iterations:</strong> shipped rapid debugging + implementation loops with concrete build/test verification per change set.</li>
              <li><strong>Portfolio delivery:</strong> continuous UX and conversion polish with reversible commits for low-risk deployment.</li>
            </ul>
          </div>

          <div class="grid grid-2" id="all-projects">
            <div class="loading-placeholder">Loading projects from GitHub...</div>
          </div>
          <div style="text-align: center; margin-top: var(--space-8);">
            <a href="https://github.com/suttonwilliamd?tab=repositories" class="btn btn-secondary" target="_blank" rel="noopener">View All on GitHub →</a>
          </div>
        </div>
      </section>
    </main>

    <Footer />

    <script>
      const GITHUB_USERNAME = 'suttonwilliamd';

      async function fetchAllProjects() {
        try {
          const reposRes = await fetch(`https://api.github.com/users/${GITHUB_USERNAME}/repos?sort=updated&per_page=100`);
          const repos = await reposRes.json();

          if (Array.isArray(repos) && repos.length > 0) {
            const projectsContainer = document.getElementById('all-projects');
            // Optional per-repo description overrides for sites like LewtNanny
            const descriptionOverrides = {
              LewtNanny: 'LewtNanny is a web-based assistant that helps caregivers manage tasks and scheduling (description updated for website).'
            };
            projectsContainer.innerHTML = repos.map(repo => `
              <article class="project-card">
                <div class="project-header">
                  <div style="display: flex; gap: var(--space-2);">
                    <div class="terminal-dot red"></div>
                    <div class="terminal-dot yellow"></div>
                    <div class="terminal-dot green"></div>
                  </div>
                  <span class="project-title">${repo.name}</span>
                </div>
                <div class="project-body">
                  <h3 class="card-title">${(descriptionOverrides[repo.name] ?? repo.description) || 'No description available'}</h3>
                  <div class="project-tags">
                    ${repo.language ? `<span class="tag">${repo.language}</span>` : ''}
                    <span class="tag">⭐ ${repo.stargazers_count}</span>
                    <span class="tag">🍴 ${repo.forks_count}</span>
                  </div>
                </div>
                <div class="project-footer">
                  <a href="${repo.html_url}" class="btn btn-primary" target="_blank" rel="noopener">View Project</a>
                  ${repo.homepage ? `<a href="${repo.homepage}" class="btn btn-secondary" target="_blank" rel="noopener">Live Demo</a>` : ''}
                </div>
              </article>
            `).join('');
          }
        } catch (error) {
          console.error('Error fetching projects:', error);
          document.getElementById('all-projects').innerHTML = '<p class="text-muted">Unable to load projects. Please visit my <a href="https://github.com/suttonwilliamd">GitHub profile</a> directly.</p>';
        }
      }

      fetchAllProjects();
    </script>
  </body>
</html>
