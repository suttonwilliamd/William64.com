---
import Layout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { projects, projectCategories } from "../data/projects";
---

<Layout
  title="Projects | William Sutton"
  description="Local-first game trackers, AI developer tools, and creative experiments. What they do, how they work, and where to try them."
>
  <PageHeader
    title="Useful tools. Curious experiments."
    eyebrow="The project notebook"
    description="Software I’ve built to understand how things work—and to make games, creative work, and working with AI a little better."
  >
    <div class="actions">
      <a
        class="text-link"
        href="https://github.com/suttonwilliamd?tab=repositories"
        >Explore my GitHub ↗</a>
    </div>
  </PageHeader>
  <section aria-labelledby="collection-heading">
    <div class="section-heading">
      <h2 id="collection-heading">
        Selected projects / {String(projects.length).padStart(2, "0")}
      </h2><p>Tools, prototypes, and works in progress.</p>
    </div>
    <div class="project-controls" hidden>
      <div
        class="category-filters"
        role="group"
        aria-label="Filter projects by category"
      >
        {
          projectCategories.map((category, index) => (
            <button
              type="button"
              class="filter-button"
              data-category={category}
              aria-pressed={index === 0}
              aria-controls="project-list"
            >
              {category}
            </button>
          ))
        }
      </div>
      <div class="project-search">
        <label for="project-search" class="sr-only">Search projects</label
        ><input
          id="project-search"
          type="search"
          placeholder="Search projects…"
          aria-controls="project-list"
        />
      </div>
    </div>
    <p id="project-count" class="result-count" role="status" hidden></p>
    <div class="project-list" id="project-list">
      {
        projects.map((project, index) => (
          <ProjectCard project={project} index={index} />
        ))
      }
    </div>
    <div class="empty-state" id="empty-state" hidden>
      <h3>No matching projects.</h3><p>
        Try a different keyword or explore another category.
      </p><button type="button" id="reset-projects" class="btn"
        >Clear filters →</button>
    </div>
    <p class="collection-note">
      A curated selection, not every repository. Project READMEs have the latest
      setup instructions and development status.
    </p>
  </section>
  <aside class="outro">
    <div>
      <p class="eyebrow">There’s always another idea</p><h2>
        More in the workshop.
      </h2><p>
        Smaller experiments, older projects, and the code behind this site live
        on GitHub.
      </p>
    </div><a
      class="btn"
      href="https://github.com/suttonwilliamd?tab=repositories"
      >Browse all repositories ↗</a>
  </aside>
</Layout>
<script>
  const controls = document.querySelector<HTMLElement>(".project-controls")!;
  const search = document.querySelector<HTMLInputElement>("#project-search")!;
  const buttons =
    document.querySelectorAll<HTMLButtonElement>(".filter-button");
  const cards = document.querySelectorAll<HTMLElement>("[data-project]");
  const count = document.querySelector<HTMLElement>("#project-count")!;
  const empty = document.querySelector<HTMLElement>("#empty-state")!;
  let category = "All projects";
  function filterProjects() {
    const query = search.value.trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const matches =
        (category === "All projects" || card.dataset.category === category) &&
        (card.dataset.search ?? "").includes(query);
      card.hidden = !matches;
      if (matches) visible++;
    });
    buttons.forEach((button) =>
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.category === category),
      ),
    );
    count.textContent = `${visible} of ${cards.length} projects`;
    empty.hidden = visible !== 0;
  }
  buttons.forEach((button) =>
    button.addEventListener("click", () => {
      category = button.dataset.category!;
      filterProjects();
    }),
  );
  search.addEventListener("input", filterProjects);
  document.querySelector("#reset-projects")!.addEventListener("click", () => {
    category = "All projects";
    search.value = "";
    filterProjects();
    search.focus();
  });
  controls.hidden = false;
  count.hidden = false;
  filterProjects();
</script>
