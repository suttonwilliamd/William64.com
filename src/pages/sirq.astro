---
import Layout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
const alerts = [
  {
    time: "00:18",
    name: "CI runner CPU spike",
    result: "routine",
    explanation:
      "A short-lived build burst returned to baseline without customer impact.",
  },
  {
    time: "00:42",
    name: "Redis latency spike",
    result: "routine",
    explanation:
      "Latency rose briefly, then recovered before the request path degraded.",
  },
  {
    time: "01:07",
    name: "Redis recovered",
    result: "routine",
    explanation:
      "A recovery event is useful context, not a second reason to wake someone.",
  },
  {
    time: "01:31",
    name: "Image worker restart",
    result: "routine",
    explanation:
      "The worker restarted and resumed its queue without a sustained backlog.",
  },
  {
    time: "02:04",
    name: "Checkout errors at 7%",
    result: "routine",
    explanation:
      "The first error burst was below the configured consequence threshold.",
  },
  {
    time: "02:18",
    name: "Checkout failing at 11%",
    result: "interrupt",
    explanation:
      "This crossed the high-consequence threshold and would wake the on-call engineer.",
  },
  {
    time: "02:41",
    name: "Same checkout incident",
    result: "duplicate",
    explanation:
      "A duplicate signal is attached to the active incident instead of creating another wake-up.",
  },
  {
    time: "03:12",
    name: "Worker healthy again",
    result: "routine",
    explanation:
      "Recovery is recorded for the timeline; it does not page the sleeping engineer.",
  },
  {
    time: "03:48",
    name: "TLS certificate expires in 18h",
    result: "interrupt",
    explanation:
      "The expiry window is actionable before the next deploy, so it remains visible as an interruption.",
  },
];
---

<Layout
  title="SIRQ — Signal before interruption | William64.com"
  description="A static Shadow Mode demonstration of SIRQ: compare nine alerts with two proposed interruptions, without changing production."
>
  <PageHeader
    title="Less noise. Keep the important signals."
    eyebrow="Project notebook / SIRQ"
    description="SIRQ explores which alerts are worth an interruption. Shadow Mode compares a proposed policy with the existing alert path—without taking production action."
  >
    <div class="actions">
      <a class="btn btn-primary" href="https://github.com/suttonwilliamd/SIRQ"
        >Inspect the source ↗</a
      ><a class="btn" href="#proof">Walk through the demo ↓</a>
    </div>
  </PageHeader>
  <div class="note">
    <p>
      <strong>Demo, not a production result.</strong> The nine-alert fixture below
      is a static, simulated night. The current evaluator is a deterministic mock.
      There are no external calls or production credentials, and Shadow Mode does
      not mute, route, remediate, or change production.
    </p>
  </div>
  <section class="section" id="proof" aria-labelledby="proof-heading">
    <div class="section-heading">
      <h2 id="proof-heading">One bad night. Two different thresholds.</h2><p>
        00:00–04:00 / Simulated fixture
      </p>
    </div>
    <p class="lede">
      The existing path treats every alert as a reason to wake an engineer. The
      comparison asks which signals carry enough consequence to justify that
      interruption.
    </p>
    <dl class="demo-metrics">
      <div><dt>Existing wake-ups</dt><dd>9</dd></div><div>
        <dt>Proposed wake-ups</dt><dd>2</dd>
      </div><div><dt>Production actions</dt><dd>0</dd></div>
    </dl>
    <div class="alert-lanes">
      <section class="card" aria-labelledby="existing-heading">
        <p class="eyebrow">Existing alert path</p><h3 id="existing-heading">
          Every event pages.
        </h3><ol class="alert-list">
          {
            alerts.map((alert) => (
              <li class="alert-item">
                <span class="meta">{alert.time}</span>{" "}
                <>
                  <span class="alert-event">{alert.name}</span>
                  <span class="alert-status interrupt">Paged</span>
                </>
              </li>
            ))
          }
        </ol>
      </section>
      <section class="card" aria-labelledby="proposed-heading">
        <p class="eyebrow">SIRQ / Shadow Mode</p><h3 id="proposed-heading">
          Same events, triaged.
        </h3><p class="small">Expand an event to inspect the reasoning.</p><div
          class="alert-list"
        >
          {
            alerts.map((alert) => (
              <details class="alert-item">
                <>
                  <summary>
                    <span class="meta">{alert.time}</span>{" "}
                    <>
                      <span class="alert-event">{alert.name}</span>
                      <span
                        class:list={[
                          "alert-status",
                          { interrupt: alert.result === "interrupt" },
                        ]}
                      >
                        {alert.result}
                      </span>
                    </>
                  </summary>
                  <p>{alert.explanation}</p>
                </>
              </details>
            ))
          }
        </div>
      </section>
    </div>
    <p class="collection-note">
      Seven fewer proposed interruptions out of nine: a 77.8% reduction in this
      fixture only. This is a counterfactual, not a measured production outcome.
    </p>
  </section>
  <section class="section split" aria-labelledby="architecture-heading">
    <div class="prose">
      <p class="eyebrow">The architecture</p><h2 id="architecture-heading">
        Interpretation is not authority.
      </h2><p>
        Adapters bring in logs, metrics, webhooks, and agent state. A semantic
        evaluator names what appears to be happening; deterministic policy
        decides whether to record, show, or notify.
      </p><div class="flow">
        <span>Raw events</span> → <span>Semantic signal</span> → <span
          >Deterministic policy</span>
      </div>
    </div>
    <aside class="card">
      <p class="eyebrow">The safety boundary</p><h3>
        Observe. Compare. Learn.
      </h3><p>
        Shadow Mode records the counterfactual beside an existing alert. It
        cannot restart services, execute shell commands, modify files, change
        networking, or give an evaluator tool access.
      </p>
    </aside>
  </section>
  <section class="section prose" aria-labelledby="try-heading">
    <p class="eyebrow">Try it locally</p><h2 id="try-heading">
      Replay the night.
    </h2><p>
      Run the local on-call demo to generate a standalone report. No production
      access is needed.
    </p><pre><code>git clone https://github.com/suttonwilliamd/SIRQ
cd SIRQ
python -m sirq.cli oncall-demo --output sirq-one-bad-night.html</code></pre>
  </section>
  <aside class="outro">
    <div>
      <h2>Start with the signal, not the action.</h2><p>
        The README explains the current implementation, policy boundaries, and
        local demos.
      </p>
    </div><a class="btn" href="https://github.com/suttonwilliamd/SIRQ"
      >SIRQ on GitHub ↗</a>
  </aside>
</Layout>
