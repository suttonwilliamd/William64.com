---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

const pageTitle = 'SIRQ | William64.com';
const pageDescription = 'SIRQ helps teams stop waking engineers for alerts that resolve themselves. Shadow Mode compares interruptions before production authority changes.';

const alerts = [
  { time: '00:18', name: 'CI runner CPU spike', result: 'routine', explanation: 'A short-lived build burst returned to baseline without customer impact.' },
  { time: '00:42', name: 'Redis latency spike', result: 'routine', explanation: 'Latency rose briefly, then recovered before the request path degraded.' },
  { time: '01:07', name: 'Redis recovered', result: 'routine', explanation: 'A recovery event is useful context, not a second reason to wake someone.' },
  { time: '01:31', name: 'Image worker restart', result: 'routine', explanation: 'The worker restarted and resumed its queue without a sustained backlog.' },
  { time: '02:04', name: 'Checkout errors at 7%', result: 'routine', explanation: 'The first error burst was below the configured consequence threshold.' },
  { time: '02:18', name: 'Checkout failing at 11%', result: 'interrupt', explanation: 'This crossed the high-consequence threshold and would wake the on-call engineer.' },
  { time: '02:41', name: 'Same checkout incident', result: 'duplicate', explanation: 'A duplicate signal is attached to the active incident instead of creating another wake-up.' },
  { time: '03:12', name: 'Worker healthy again', result: 'routine', explanation: 'Recovery is recorded for the timeline; it does not page the sleeping engineer.' },
  { time: '03:48', name: 'TLS certificate expires in 18h', result: 'interrupt', explanation: 'The expiry window is actionable before the next deploy, so it remains visible as an interruption.' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header class="header"><div class="header-inner"><Navigation /></div></header>

    <main id="main-content" class="sirq-page">
      <section class="sirq-story sirq-hero" id="top">
        <div class="sirq-wrap sirq-hero-grid">
          <div class="sirq-reveal">
            <p class="sirq-eyebrow">SIRQ · Shadow Mode</p>
            <h1>Stop waking engineers for alerts that resolve themselves.</h1>
            <p class="sirq-lede">SIRQ watches the alert path you already have, then shows which interruptions were actually worth waking someone for—without taking production action.</p>
            <div class="sirq-actions">
              <a class="sirq-button sirq-button-primary" href="https://github.com/suttonwilliamd/SIRQ" target="_blank" rel="noopener">View SIRQ on GitHub →</a>
              <a class="sirq-button sirq-button-secondary" href="#proof">Scroll through the proof</a>
            </div>
            <p class="sirq-microcopy">One bad night · 00:00—04:00 · static fixture · no external calls</p>
          </div>
          <div class="sirq-hero-note sirq-reveal" aria-label="Shadow Mode safety boundary">
            <span class="sirq-note-label">Safety boundary</span>
            <strong>Observe. Compare. Learn.</strong>
            <p>Shadow Mode records the counterfactual beside the alert you already received. It does not mute, route, remediate, or change production.</p>
            <div class="sirq-denied"><span>✓ read-only inputs</span><span>✓ inspectable policy</span><span>✕ production actions</span></div>
          </div>
        </div>
        <a class="sirq-scrollcue" href="#proof" aria-label="Scroll to the proof"><i></i>scroll through the proof</a>
      </section>

      <section class="sirq-story sirq-night" id="proof">
        <div class="sirq-wrap sirq-night-grid">
          <div class="sirq-reveal"><p class="sirq-eyebrow">The input</p><h2>9 alerts entered the night.</h2><p class="sirq-copy">The existing system treated all nine as reasons to wake an engineer. SIRQ asks a narrower question: which signals carry enough consequence to interrupt sleep?</p></div>
          <div class="sirq-clock sirq-reveal" aria-label="Nine alerts across one four-hour night">
            {Array.from({ length: 9 }).map((_, index) => <span class="sirq-tick" style={`--i:${index}`}></span>)}
            <span class="sirq-dot" style="--x:-105px;--y:-92px"></span><span class="sirq-dot" style="--x:68px;--y:-112px"></span><span class="sirq-dot" style="--x:124px;--y:-14px"></span><span class="sirq-dot" style="--x:99px;--y:94px"></span><span class="sirq-dot" style="--x:2px;--y:130px"></span><span class="sirq-dot" style="--x:-104px;--y:90px"></span><span class="sirq-dot" style="--x:-132px;--y:10px"></span><span class="sirq-dot sirq-danger" style="--x:-66px;--y:-30px"></span><span class="sirq-dot sirq-danger" style="--x:42px;--y:38px"></span>
            <div class="sirq-clock-label"><b>9</b><span>incoming alerts</span></div>
          </div>
        </div>
      </section>

      <section class="sirq-story sirq-comparison">
        <div class="sirq-wrap sirq-reveal">
          <p class="sirq-eyebrow">The comparison</p><h2>Same night.<br /><span>Different threshold.</span></h2><p class="sirq-lede">Both systems see the same named events. Only the high-consequence signals should reach a sleeping engineer.</p>
          <div class="sirq-lanes">
            <article class="sirq-lane sirq-old"><h3>Existing path <small>every alert pages</small></h3><div class="sirq-bars">{alerts.map((alert) => <div class="sirq-barrow"><div class="sirq-event"><strong>{alert.time}</strong><span>{alert.name}</span><em>paged</em></div><div class="sirq-bar"><i style="--fill:1"></i></div></div>)}</div><div class="sirq-lane-foot"><b>9</b><span>wake-ups delivered</span></div></article>
            <article class="sirq-lane sirq-new"><h3>SIRQ Shadow Mode <small>same events, triaged</small></h3><div class="sirq-bars">{alerts.map((alert) => <details class:list={{ 'sirq-barrow': true, 'sirq-interrupt': alert.result === 'interrupt' }}><summary><div class="sirq-event"><strong>{alert.time}</strong><span>{alert.name}</span><em>{alert.result.toUpperCase()}</em></div><div class="sirq-bar"><i style={`--fill:${alert.result === 'interrupt' ? 1 : 0.12}`}></i></div></summary><p>{alert.explanation}</p></details>)}</div><div class="sirq-lane-foot"><b>2</b><span>would wake an engineer</span></div></article>
          </div>
        </div>
      </section>

      <section class="sirq-story sirq-result">
        <div class="sirq-wrap sirq-result-grid">
          <div class="sirq-reveal"><p class="sirq-eyebrow">The result</p><div class="sirq-metric">77.8%<small>potential interruption reduction</small></div><p class="sirq-lede">This is a counterfactual, not a claim that production was changed. Shadow Mode lets you measure the quieter path before you trust it.</p></div>
          <div class="sirq-result-card sirq-reveal"><div><span>Existing interruptions</span><strong>9</strong></div><div><span>SIRQ interruptions</span><strong>2</strong></div><div><span>Production actions</span><strong class="sirq-zero">ZERO</strong></div></div>
        </div>
      </section>

      <section class="sirq-story sirq-architecture" id="architecture">
        <div class="sirq-wrap sirq-architecture-grid">
          <div class="sirq-boundary sirq-reveal">
            <p class="sirq-eyebrow">Before architecture</p>
            <h2>No production actions.</h2>
            <p>Shadow Mode reads the existing alert stream and records a comparison. It cannot mute, route, remediate, restart, or change production.</p>
            <div class="sirq-denied"><span>✓ read-only inputs</span><span>✓ inspectable policy</span><span>✕ production authority</span></div>
          </div>
          <div class="sirq-reveal">
            <p class="sirq-eyebrow">The architecture</p>
            <h2>Signal in. Policy out.</h2>
            <p class="sirq-copy">Adapters bring in logs, metrics, webhooks, and agent state. A semantic evaluator names what appears to be happening; deterministic policy decides whether to record, show, or notify.</p>
            <div class="sirq-flow"><span>raw events</span><i>→</i><span>semantic signal</span><i>→</i><span>deterministic policy</span></div>
          </div>
        </div>
      </section>

      <section class="sirq-story sirq-close">
        <div class="sirq-wrap sirq-reveal"><p class="sirq-eyebrow">Shadow Mode first</p><h2>See the signal before changing the system.</h2><p class="sirq-lede">Replay one bad night. Tune the threshold. Keep authority where it belongs: in inspectable policy code.</p><div class="sirq-close-actions"><a class="sirq-button sirq-button-primary" href="https://github.com/suttonwilliamd/SIRQ" target="_blank" rel="noopener">Inspect the project on GitHub →</a><a class="sirq-button sirq-button-secondary" href="#top">Replay the night ↑</a></div><pre class="sirq-command"><code>git clone https://github.com/suttonwilliamd/SIRQ
 cd SIRQ
python -m sirq.cli oncall-demo --output sirq-one-bad-night.html</code></pre><p class="sirq-microcopy">Local on-call demo: replay the nine-alert fixture without external calls or production credentials.</p></div>
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .sirq-page{--sirq-ink:#eef5f4;--sirq-muted:#91a5a4;--sirq-deep:#07100f;--sirq-panel:#0d1b19;--sirq-line:#23423d;--sirq-mint:#8de6bf;--sirq-amber:#f6c86e;--sirq-coral:#f28b79;background:var(--sirq-deep);color:var(--sirq-ink);overflow:hidden}.sirq-page *{box-sizing:border-box}.sirq-wrap{width:min(1060px,100%);margin:auto}.sirq-story{min-height:100vh;padding:clamp(100px,12vw,150px) clamp(20px,7vw,110px);display:grid;align-items:center;position:relative}.sirq-page:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.12;background-image:radial-gradient(var(--sirq-mint) .7px,transparent .7px);background-size:28px 28px;mask-image:linear-gradient(to bottom,#000,transparent 70%)}.sirq-eyebrow,.sirq-microcopy,.sirq-note-label{color:var(--sirq-mint);font:600 12px ui-monospace,monospace;letter-spacing:.15em;text-transform:uppercase}.sirq-hero{background:radial-gradient(ellipse at 65% 35%,#153630 0,#07100f 55%);min-height:calc(100vh - 72px)}.sirq-hero-grid,.sirq-night-grid,.sirq-result-grid,.sirq-architecture-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(30px,7vw,100px);align-items:center}.sirq-hero h1,.sirq-night h2,.sirq-comparison h2,.sirq-close h2{font-size:clamp(42px,7vw,88px);line-height:.95;letter-spacing:-.07em;margin:0;max-width:850px}.sirq-hero h1{font-size:clamp(48px,8vw,108px)}.sirq-lede{max-width:620px;color:var(--sirq-muted);font-size:clamp(17px,2vw,21px);margin:24px 0 0}.sirq-copy{color:var(--sirq-muted);font-size:18px;max-width:400px}.sirq-actions,.sirq-close-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:30px}.sirq-button{display:inline-flex;text-decoration:none;border-radius:999px;padding:14px 18px;font-weight:700;align-items:center}.sirq-button-primary{background:var(--sirq-mint);color:var(--sirq-deep)}.sirq-button-secondary{border:1px solid var(--sirq-line);color:var(--sirq-ink)}.sirq-microcopy{color:var(--sirq-muted);font-size:10px;letter-spacing:.08em;margin-top:24px}.sirq-hero-note{border:1px solid var(--sirq-mint);border-radius:24px;padding:30px;background:#102822;box-shadow:0 20px 80px #45c99713}.sirq-hero-note strong{display:block;font-size:clamp(24px,3vw,38px);letter-spacing:-.05em;margin:14px 0}.sirq-hero-note p{color:var(--sirq-muted);font-size:16px}.sirq-denied{display:flex;flex-wrap:wrap;gap:12px;color:var(--sirq-muted);font:12px ui-monospace,monospace}.sirq-denied span:last-child{color:var(--sirq-coral)}.sirq-scrollcue{position:absolute;bottom:38px;color:var(--sirq-muted);font:12px ui-monospace,monospace;display:flex;gap:12px;align-items:center;text-decoration:none}.sirq-scrollcue i{display:block;width:42px;height:1px;background:var(--sirq-mint)}.sirq-clock{width:min(430px,80vw);aspect-ratio:1;border:1px solid var(--sirq-line);border-radius:50%;position:relative;background:radial-gradient(circle,#0c211d,#07100f 66%);box-shadow:0 0 90px #45c99714;margin:auto}.sirq-tick{position:absolute;inset:9%;border-radius:50%;transform:rotate(calc(var(--i)*40deg))}.sirq-tick:after{content:"";position:absolute;left:49%;top:-2px;width:2px;height:10px;background:var(--sirq-line)}.sirq-dot{position:absolute;width:11px;height:11px;border-radius:50%;background:var(--sirq-amber);box-shadow:0 0 0 5px #f6c86e16;left:calc(50% + var(--x));top:calc(50% + var(--y));transform:translate(-50%,-50%)}.sirq-dot.sirq-danger{background:var(--sirq-coral);box-shadow:0 0 0 5px #f28b7919}.sirq-clock-label{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);text-align:center}.sirq-clock-label b{display:block;font-size:48px;letter-spacing:-.08em}.sirq-clock-label span{color:var(--sirq-muted);font:12px ui-monospace,monospace;text-transform:uppercase;letter-spacing:.12em}.sirq-comparison{background:#0b1514}.sirq-comparison h2 span{color:var(--sirq-mint)}.sirq-lanes{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:36px}.sirq-lane{border:1px solid var(--sirq-line);border-radius:18px;padding:24px;background:var(--sirq-panel)}.sirq-lane h3{margin:0 0 20px;font:600 14px ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase}.sirq-lane h3 small{display:block;margin-top:5px;font-size:10px;font-weight:400;letter-spacing:.04em;text-transform:none;color:var(--sirq-muted)}.sirq-old h3{color:var(--sirq-coral)}.sirq-new h3{color:var(--sirq-mint)}.sirq-bars{display:grid;gap:10px}.sirq-barrow,.sirq-barrow summary{display:grid;grid-template-columns:minmax(150px,1fr) 34%;gap:12px;align-items:center;font:12px ui-monospace,monospace;color:var(--sirq-muted)}.sirq-barrow summary{cursor:pointer;list-style:none}.sirq-barrow summary::-webkit-details-marker{display:none}.sirq-event{display:grid;gap:2px;min-width:0}.sirq-event strong{color:var(--sirq-ink);font-size:11px}.sirq-event span{color:var(--sirq-ink);font-size:12px;line-height:1.15}.sirq-event em{font-style:normal;font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:var(--sirq-muted)}.sirq-old .sirq-event em{color:var(--sirq-coral)}.sirq-new .sirq-event em{color:var(--sirq-mint)}.sirq-bar{height:16px;background:#18302b;border-radius:5px;overflow:hidden}.sirq-bar i{display:block;height:100%;width:100%;background:var(--sirq-coral);border-radius:5px;transform-origin:left;transform:scaleX(var(--fill))}.sirq-new .sirq-bar i{background:var(--sirq-mint)}.sirq-barrow p{grid-column:1/-1;color:var(--sirq-muted);font:13px/1.5 system-ui,sans-serif;border-top:1px solid var(--sirq-line);padding:10px 0 0;margin:0}.sirq-lane-foot{border-top:1px solid var(--sirq-line);margin-top:23px;padding-top:18px;display:flex;justify-content:space-between;align-items:end}.sirq-lane-foot b{font-size:38px;letter-spacing:-.06em}.sirq-old .sirq-lane-foot b{color:var(--sirq-coral)}.sirq-new .sirq-lane-foot b{color:var(--sirq-mint)}.sirq-architecture{background:#0b1514}.sirq-boundary{border:1px solid var(--sirq-coral);border-radius:24px;padding:30px;background:#1a1816}.sirq-boundary h2,.sirq-architecture h2{font-size:clamp(36px,5vw,64px);line-height:.95;letter-spacing:-.06em;margin:12px 0}.sirq-boundary p{color:var(--sirq-muted);font-size:16px}.sirq-flow{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-top:28px;font:12px ui-monospace,monospace;text-transform:uppercase;letter-spacing:.06em}.sirq-flow span{border:1px solid var(--sirq-line);border-radius:999px;padding:10px 12px;color:var(--sirq-ink);background:var(--sirq-panel)}.sirq-flow i{color:var(--sirq-mint);font-style:normal}.sirq-result{background:linear-gradient(180deg,#07100f,#0c201b)}.sirq-metric{font-size:clamp(90px,15vw,180px);line-height:.8;letter-spacing:-.1em;color:var(--sirq-mint);margin:28px 0}.sirq-metric small{display:block;font-size:15px;letter-spacing:.1em;color:var(--sirq-muted);line-height:1.2;text-transform:uppercase;margin:22px 0 0 8px}.sirq-result-card{border:1px solid var(--sirq-mint);border-radius:24px;padding:30px;background:#102822;box-shadow:0 20px 80px #45c99713}.sirq-result-card div{display:flex;justify-content:space-between;padding:16px 0;border-bottom:1px solid #2c5047}.sirq-result-card div:last-child{border:0}.sirq-result-card span{color:var(--sirq-muted)}.sirq-result-card strong{color:var(--sirq-mint);font-size:20px}.sirq-result-card .sirq-zero{font-size:70px;letter-spacing:-.08em}.sirq-close{text-align:center;min-height:72vh}.sirq-close .sirq-lede{margin-left:auto;margin-right:auto}.sirq-close-actions{justify-content:center}.sirq-command{max-width:620px;margin:34px auto 0;text-align:left;background:#081311;border:1px solid var(--sirq-line);border-radius:14px;padding:18px;overflow:auto;color:var(--sirq-mint);font:13px/1.6 ui-monospace,monospace}.sirq-reveal{animation:sirq-rise .8s ease both}@keyframes sirq-rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}@media(max-width:760px){.sirq-story{padding-top:90px}.sirq-hero-grid,.sirq-night-grid,.sirq-result-grid,.sirq-lanes{grid-template-columns:1fr}.sirq-clock{width:min(360px,82vw);margin:0 auto}.sirq-hero-note{margin-top:10px}.sirq-scrollcue{display:none}}@media(prefers-reduced-motion:reduce){.sirq-reveal{animation:none}}
</style>
