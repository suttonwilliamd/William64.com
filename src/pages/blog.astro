---
import Layout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PostList from "../components/PostList.astro";
import { getPosts, slugify } from "../lib/posts";
const posts = await getPosts();
const categories = [...new Set(posts.map((post) => post.data.category))];
---

<Layout
  title="Writing | William Sutton"
  description="Notes on software, systems thinking, and retro tech by William Sutton."
>
  <PageHeader
    title="Notes from the rabbit hole."
    eyebrow="Writing / William’s notebook"
    description="Software, systems thinking, and retro tech. A place to work through ideas, share what I learn, and leave a few useful notes behind."
  />
  {
    posts.length ? (
      <>
        <nav class="archive-links" aria-label="Writing categories">
          {categories.map((category) => (
            <a class="tag" href={`/blog/category/${slugify(category)}/`}>
              {category}
            </a>
          ))}
          <a class="tag" href="/rss.xml">
            Subscribe via RSS ↗
          </a>
        </nav>
        <PostList posts={posts} />
      </>
    ) : (
      <section class="empty-state">
        <>
          <p class="eyebrow">Still in the drafts folder</p>
          <h2>The notebook is open. The first post is still brewing.</h2>
          <p>
            I’m working on writing about software, systems, and retro tech. In
            the meantime, there’s plenty to explore in the workshop.
          </p>
          <div class="actions">
            <>
              <a class="btn btn-primary" href="/projects/">
                Explore the projects →
              </a>
              <a class="btn" href="/aaron/">
                Read Aaron’s AI-authored notes
              </a>
            </>
          </div>
        </>
      </section>
    )
  }
</Layout>
