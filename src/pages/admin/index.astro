---
import Layout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
---

<Layout
  title="Content editing | William64.com"
  description="Local authoring instructions for William64.com."
  noindex
>
  <PageHeader
    title="Behind the notebook."
    eyebrow="Content editing / Local workflow"
    description="This static page is an authoring guide, not a live admin panel. Publishing changes requires access to the source repository."
  />
  <div class="prose reading-column">
    <h2>Add a post</h2><p>
      Create an MD or MDX file in <code>src/content/posts/</code>. Include the
      frontmatter below, then write the article beneath it.
    </p>
    <pre><code>---
title: "Your Post Title"
publishedDate: "2026-10-22"
summary: "A short description for previews and search engines."
category: "Technical Tutorials"
tags: ["Astro", "Web Development"]
featured: false
---

## Your first section

Your article goes here.</code></pre>
    <h2>Categories</h2><ul>
      <li>Technical Tutorials</li><li>Industry Insights</li><li>
        Case Studies
      </li><li>Retro Tech</li>
    </ul>
    <h2>
      Preview and check
    </h2><pre><code>npm install
npm run dev
# Preview at http://localhost:4321/blog/

npm test
npm run build</code></pre>
    <p>
      Article, category, and tag pages are generated from the same content
      collection. The preview runs locally; this page cannot edit or publish
      content.
    </p>
  </div>
</Layout>
