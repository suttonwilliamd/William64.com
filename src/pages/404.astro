---
import Layout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
---

<Layout
  title="Page not found | William64.com"
  description="This page is missing, but there’s plenty more to explore."
  noindex
>
  <PageHeader
    title="That rabbit hole ends here."
    eyebrow="404 / Page not found"
    description="The page may have moved, or the link might be a little off. Let’s get you back to something useful."
  >
    <div class="actions">
      <a class="btn btn-primary" href="/">Back home →</a><a
        class="btn"
        href="/projects/">Explore the projects</a>
    </div>
  </PageHeader>
</Layout>
