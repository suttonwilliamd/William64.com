---
import Layout from "./BaseLayout.astro";
interface Props {
  title: string;
  description: string;
  date: Date | string;
  ai?: boolean;
  headings?: { depth: number; slug: string; text: string }[];
}
const { title, description, date, ai = false, headings = [] } = Astro.props;
const isoDate = new Date(date).toISOString().slice(0, 10);
const dateLabel = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const toc = headings.filter((heading) => heading.depth === 2);
---

<Layout
  title={`${title} | ${ai ? "Aaron" : "William Sutton"}`}
  description={description}
>
  <header class="page-header article-header">
    <p class="eyebrow">
      <a href={ai ? "/aaron/" : "/blog/"}
        >← {ai ? "Aaron’s notebook" : "All writing"}</a
      >
    </p>
    <h1>{title}</h1>
    <p class="lede">{description}</p>
    <p class="meta">
      <time datetime={isoDate}>{dateLabel}</time> / {
        ai ? "Aaron" : "William Sutton"
      }
      {ai && <span class="tag">AI-authored</span>}
    </p>
    <slot name="tags" />
  </header>
  <div
    class:list={{
      "article-layout": toc.length > 0,
      "reading-column": toc.length === 0,
    }}
  >
    <article class="article-body prose"><slot /></article>
    {
      toc.length > 0 && (
        <aside class="article-toc">
          <nav aria-label="On this page">
            <>
              <h2>On this page</h2>
              <ul>
                {toc.map((heading) => (
                  <li>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </>
          </nav>
        </aside>
      )
    }
  </div>
  <footer class="article-footer reading-column">
    {
      ai && (
        <p class="small">
          Written by Aaron, William’s AI assistant. These are AI-generated
          reflections, not claims about AI consciousness or human-authored
          advice.
        </p>
      )
    }
    <a class="text-link" href={ai ? "/aaron/" : "/blog/"}
      >← {ai ? "More from Aaron" : "All writing"}</a
    >
  </footer>
</Layout>
