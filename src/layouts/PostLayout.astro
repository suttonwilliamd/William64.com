---
import ArticleLayout from "./ArticleLayout.astro";
import { slugify } from "../lib/posts";
const { frontmatter, headings = [] } = Astro.props;
---

<ArticleLayout
  title={frontmatter.title}
  description={frontmatter.summary}
  date={frontmatter.publishedDate}
  headings={headings}
>
  <ul class="tags" slot="tags">
    <li>
      <a class="tag" href={`/blog/category/${slugify(frontmatter.category)}/`}
        >{frontmatter.category}</a>
    </li>{
      frontmatter.tags.map((tag) => (
        <li>
          <a class="tag" href={`/blog/tag/${slugify(tag)}/`}>
            {tag}
          </a>
        </li>
      ))
    }
  </ul>
  <slot />
</ArticleLayout>
